// Prisma schema para usuários, grupos e permissões
// Salve como schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Content {
  id        Int      @id @default(autoincrement())
  section   String   // Ex: 'hero', 'about', 'skills', etc.
  language  String   // Ex: 'pt', 'en', 'es'
  title     String?
  subtitle  String?
  description String?
  data      Json?
  updatedAt DateTime @updatedAt
}

model Post {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  title      String
  image      String
  date       String
  excerpt    String
  content    String
  tags       String[]
  author     String?
  categories String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  group     Group?   @relation(fields: [groupId], references: [id])
  groupId   Int?
  resetToken String? // Para recuperação de senha
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  permissions Permission[]
  users       User[]
}

model Permission {
  id      Int    @id @default(autoincrement())
  name    String @unique
  group   Group? @relation(fields: [groupId], references: [id])
  groupId Int?
}
